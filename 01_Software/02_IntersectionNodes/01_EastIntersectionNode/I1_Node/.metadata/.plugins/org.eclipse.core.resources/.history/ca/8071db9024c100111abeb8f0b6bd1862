#define MSG_QUEUE					2

#define Q_FLAGS 		O_RDWR | O_CREAT | O_EXCL
#define Q_Mode 			S_IRUSR | S_IWUSR
#define MY_PULSE_CODE 	_PULSE_CODE_MINAVAIL

#define I1_CAR_Q       "/I1_car_input"
#define I1_PED_Q       "/I1_ped_input"
#define I1_TRAIN_Q     "/I1_train_input"
#define I1_CENTRAL_Q   "/I1_central_input"

#define PED_W1 		   	(1u << 0)
#define PED_W2		   	(1u << 1)
#define PED_W3 		   	(1u << 2)
#define PED_W4		   	(1u << 3)
#define PED_W5 		   	(1u << 4)
#define PED_W6		   	(1u << 5)

#define PED_GROUP_R1	(PED_W1 | PED_W2)
#define PED_GROUP_R3	(PED_W3 | PED_W6)

char *program_name = "I1_Node.c";

typedef struct{
	enum {
		STATE_ALL_RED,
		STATE_R3_GREEN,
		STATE_R3_YELLOW,
		STATE_R1_GREEN,
		STATE_R1_YELLOW,
		STATE_WAIT_TRAIN,
		STATE_FAIL
	}state_e;

	enum {
		SENSOR_NONE,
		SENSOR_R1,
		SENSOR_R3
	}car_e;

	enum {
		TRAIN_NONE,
		TRAIN_PRESENT
	}train_e;

	pthread_mutex_t car_mutex, pedes_mutex, train_mutex;
	pthread_cond_t car_cond, pedes_cond, train_cond;

	//QNX Message Queue parameters
	mqd_t car_q;
	mqd_t ped_q;
	mqd_t train_q;
	mqd_t central_q;

	//QNX Periodic Timer parameters
	int timer_chid;
	int timer_rcvid;
	timer_t timer_id;

	struct sigevent timer_evt;
	struct _pulse timer_pulse;
	struct itimerspec timer_green_spec, timer_yellow_spec,
		timer_red_spec, timer_pedes_spec, timer_turn_spec;
	struct sched_param timer_param;

}traffic_t;

typedef struct {
	int cmd;
	int val;
}central_cmd_t;

void *check_car(void *data)
{
	traffic_t *car_traffic = (traffic_t*) data;
	char msg_recv[MSG_QUEUE] = {};
	struct mq_attr q_attr;
	for(;;)
	{
		if((car_traffic->car_q = mq_open(I1_CAR_Q, O_RDONLY)) != -1)
		{
			mq_getattr(car_traffic->car_q, &q_attr);
			mq_receive(car_traffic->car_q, msg_recv, MSG_QUEUE, NULL);
			pthread_mutex_lock(&car_traffic->car_mutex);
			if(msg_recv[0] == 'R')
			{
				switch(msg_recv[1])
				{
				case '1':
					car_traffic->car_e = SENSOR_R1;
					break;

				case '3':
					car_traffic->car_e = SENSOR_R3;
					break;

				default:
					car_traffic->car_e = SENSOR_NONE;
					break;
				}
			}
			else
			{
				car_traffic->car_e = SENSOR_NONE;
				printf("Invalid car state");
				return -1;
			}
			pthread_cond_signal(&car_traffic->car_cond);
			pthread_mutex_unlock(&car_traffic->car_mutex);
		}
		usleep(1);
	}
	mq_close(car_traffic->car_q);

	return 0;
}

void *check_pedes(void *data)
{
	traffic_t *pedes_traffic = (traffic_t*) data;
	char msg_recv[MSG_QUEUE] = {};
	struct mq_attr q_attr;
	for(;;)
	{
		if((pedes_traffic->ped_q = mq_open(I1_PED_Q, O_RDONLY)) != -1)
		{
			mq_getattr(pedes_traffic->ped_q, &q_attr);
			mq_receive(pedes_traffic->ped_q, msg_recv, MSG_QUEUE, NULL);
			pthread_mutex_lock(&pedes_traffic->pedes_mutex);
			if(msg_recv[0] == 'P')
			{
				switch(msg_recv[1])
				{
				case '1':
					pedes_traffic->ped_q |= PED_W1;
					break;

				case '2':
					pedes_traffic->ped_q |= PED_W2;
					break;

				case '3':
					pedes_traffic->ped_q |= PED_W3;
					break;

				case '4':
					pedes_traffic->ped_q |= PED_W4;
					break;

				case '5':
					pedes_traffic->ped_q |= PED_W5;
					break;

				case '6':
					pedes_traffic->ped_q |= PED_W6;
					break;

				default:
					printf("Invalid state");
					break;
				}
			}
			else
			{
				printf("Invalid pedes state");
				return -1;
			}
			pthread_cond_signal(&pedes_traffic->pedes_cond);
			pthread_mutex_unlock(&pedes_traffic->pedes_mutex);
		}
		usleep(1);
	}
	mq_close(pedes_traffic->ped_q);

	return 0;
}

void *check_train(void *data)
{
	traffic_t *train_traffic = (traffic_t*) data;
	char msg_recv[MSG_QUEUE] = {};
	struct mq_attr q_attr;
	for(;;)
	{
		if((train_traffic->train_q = mq_open(I1_TRAIN_Q, O_RDONLY)) != -1)
		{
			mq_getattr(train_traffic->train_q, &q_attr);
			mq_receive(train_traffic->train_q, msg_recv, MSG_QUEUE, NULL);
			pthread_mutex_lock(&train_traffic->train_mutex);
			if(msg_recv[0] == 'T')
			{
				switch(msg_recv[1])
				{
				case '1':
					train_traffic->train_q = TRAIN_PRESENT;
					break;

				default:
					train_traffic->train_q = TRAIN_NONE;
					break;
				}
			}
			pthread_cond_signal(&train_traffic->train_cond);
			pthread_mutex_unlock(&train_traffic->train_mutex);
		}
		usleep(1);
	}
	mq_close(train_traffic->train_q);

	return 0;
}

void initialise_timer(traffic_t *traffic_timer)
{
	//Create a channel
	traffic_timer->timer_chid = ChannelCreate(0);
	traffic_timer->timer_evt.sigev_notify = SIGEV_PULSE;

	//Create a connection back to ourselves for the timer to send the pulse on
	traffic_timer->timer_evt.sigev_coid = ConnectAttach(ND_LOCAL_NODE, 0, traffic_timer->timer_chid, _NTO_SIDE_CHANNEL, 0);
	if (traffic_timer->timer_evt.sigev_coid == -1)
	{
	   printf(stderr, "%s:  couldn't ConnectAttach to self!\n", program_name);
	   perror(NULL);
	   exit(EXIT_FAILURE);
	}
	pthread_getschedparam(pthread_self(), NULL, &traffic_timer->timer_param);
	traffic_timer->timer_evt.sigev_priority = traffic_timer->timer_param.sched_curpriority;    // old QNX660 version getprio(0);
	traffic_timer->timer_evt.sigev_code = MY_PULSE_CODE;

	//Create the timer then bind it to the event
	if (timer_create(CLOCK_REALTIME, &traffic_timer->timer_evt, &traffic_timer->timer_id) == -1)
	{
	   printf(stderr, "%s:  couldn't create a timer, errno %d\n", program_name, errno);
	   perror (NULL);
	   exit (EXIT_FAILURE);
	}

	//Set timer for green
	traffic_timer->timer_green_spec.it_value.tv_sec = 30;
	traffic_timer->timer_green_spec.it_value.tv_nsec = 0;
	traffic_timer->timer_green_spec.it_interval.tv_sec = 30;
	traffic_timer->timer_green_spec.it_interval.tv_nsec = 0;
	//Set timer for yellow
	traffic_timer->timer_yellow_spec.it_value.tv_sec = 10;
	traffic_timer->timer_yellow_spec.it_value.tv_nsec = 0;
	traffic_timer->timer_yellow_spec.it_interval.tv_sec = 10;
	traffic_timer->timer_yellow_spec.it_interval.tv_nsec = 0;
	//Set timer for red
	traffic_timer->timer_red_spec.it_value.tv_sec = 0;
	traffic_timer->timer_red_spec.it_value.tv_nsec = 0;
	traffic_timer->timer_red_spec.it_interval.tv_sec = 0;
	traffic_timer->timer_red_spec.it_interval.tv_nsec = 0;
	//Set timer for pedestrian
	traffic_timer->timer_pedes_spec.it_value.tv_sec = 20;
	traffic_timer->timer_pedes_spec.it_value.tv_nsec = 0;
	traffic_timer->timer_pedes_spec.it_interval.tv_sec = 20;
	traffic_timer->timer_pedes_spec.it_interval.tv_nsec = 0;
	//Set timer for turn signal
	traffic_timer->timer_pedes_spec.it_value.tv_sec = 10;
	traffic_timer->timer_pedes_spec.it_value.tv_nsec = 0;
	traffic_timer->timer_pedes_spec.it_interval.tv_sec = 10;
	traffic_timer->timer_pedes_spec.it_interval.tv_nsec = 0;
}

