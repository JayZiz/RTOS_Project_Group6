int main(int argc, char *argv[])
{
	printf("Intersection I1 Node in operation ...\n");

	traffic_t I1_traffic = {
			.state_e = STATE_ALL_RED,
			.car_e = SENSOR_NONE,
			.train_e = TRAIN_NONE,
			.car_mutex = PTHREAD_MUTEX_INITIALIZER,
			.car_cond = PTHREAD_COND_INITIALIZER,
			.pedes_mutex = PTHREAD_MUTEX_INITIALIZER,
			.pedes_cond = PTHREAD_COND_INITIALIZER,
			.train_mutex = PTHREAD_MUTEX_INITIALIZER,
			.train_cond = PTHREAD_COND_INITIALIZER
	};

	pthread_t car_thread, pedes_thread, train_thread;
	void *retVal;

	pthread_create(&car_thread, NULL, check_car, &I1_traffic);
	pthread_create(&pedes_thread, NULL, check_pedes, &I1_traffic);
	pthread_create(&train_thread, NULL, check_train, &I1_traffic);

	pthread_mutex_init(&I1_traffic.car_mutex, NULL);
	pthread_mutex_init(&I1_traffic.pedes_mutex, NULL);
	pthread_mutex_init(&I1_traffic.train_mutex, NULL);

	for(;;)
	{
		I1_fsm_traffic(&I1_traffic);
		usleep(1);
	}

	pthread_join(car_thread, &retVal);
	pthread_join(pedes_thread, &retVal);
	pthread_join(train_thread, &retVal);

	pthread_mutex_destroy(&I1_traffic.car_mutex);
	pthread_mutex_destroy(&I1_traffic.pedes_mutex);
	pthread_mutex_destroy(&I1_traffic.train_mutex);

	return EXIT_SUCCESS;
}
